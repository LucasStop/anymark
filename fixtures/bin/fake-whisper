#!/usr/bin/env node
// Stand-in for whisper-cli so tests never need a model. Prints what it was asked to do, so a test can
// check the flags. The child env is allowlisted, so a `whisper.fail` file next to the temp dir (the test's TMPDIR)
// makes it exit non-zero and leak a secret on stderr.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
const args = process.argv.slice(2);
if (existsSync(join(process.cwd(), '..', 'whisper.fail'))) {
  process.stderr.write('leaked-secret /Users/me/key');
  process.exit(3);
}
const value = (flag) => args[args.indexOf(flag) + 1];
process.stdout.write(`\n heard lang=${value('-l')} ctx=${value('-mc')} nt=${args.includes('-nt')}\n`);
