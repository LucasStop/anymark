# Copie para .env e preencha. Nunca commite o .env.
# Tudo é opcional: sem chave, o backend remoto correspondente fica indisponível.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Caminho do modelo ggml do whisper.cpp (ex.: ggml-medium.bin). Sem valor padrão fixo.
ANYMARK_WHISPER_MODEL=
# 1 liga os testes que chamam backends reais e gastam quota.
ANYMARK_LIVE=
