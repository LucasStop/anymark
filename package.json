{
  "name": "anymark",
  "version": "0.0.0",
  "description": "Convert any file to Markdown. Pluggable converters and AI backends with fallback.",
  "license": "MIT",
  "author": "Lucas Stopinski da Silva",
  "contributors": [
    "Lucas Bruno e Silva"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasStop/anymark.git"
  },
  "bugs": {
    "url": "https://github.com/LucasStop/anymark/issues"
  },
  "homepage": "https://github.com/LucasStop/anymark#readme",
  "keywords": [
    "markdown",
    "converter",
    "docx",
    "pdf",
    "xlsx",
    "pptx",
    "ocr",
    "rag"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepack": "yarn build",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.12.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "chardet": "^2.2.0",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "6.4.299",
    "read-excel-file": "^9.3.12",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.9.0"
  }
}
